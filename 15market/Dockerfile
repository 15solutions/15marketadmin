# Build stage
FROM node:20-alpine AS builder
WORKDIR /app
COPY package*.json ./
RUN npm install --legacy-peer-deps
ENV NODE_OPTIONS="--max-old-space-size=4096"
COPY . .

# Build-time environment variables — must be declared as ARG so Render passes
# them into the Docker build context, then set as ENV so Vite can read them.
ARG VITE_ARC_CONTRACT_ADDRESS
ARG VITE_KEEPER_URL
ARG VITE_KEEPER_URL_ARC
ARG VITE_KEEPER_URL_ROUNDS
ARG VITE_PRICE_FEED_URL
ARG VITE_SUPABASE_ANON_KEY
ARG VITE_SUPABASE_AUTH_URL
ARG VITE_SUPABASE_URL
ARG VITE_PRIVY_APP_ID
ARG VITE_REOWN_PROJECT_ID
ARG VITE_ADMIN_TOKEN

ENV VITE_ARC_CONTRACT_ADDRESS=$VITE_ARC_CONTRACT_ADDRESS
ENV VITE_KEEPER_URL=$VITE_KEEPER_URL
ENV VITE_KEEPER_URL_ARC=$VITE_KEEPER_URL_ARC
ENV VITE_KEEPER_URL_ROUNDS=$VITE_KEEPER_URL_ROUNDS
ENV VITE_PRICE_FEED_URL=$VITE_PRICE_FEED_URL
ENV VITE_SUPABASE_ANON_KEY=$VITE_SUPABASE_ANON_KEY
ENV VITE_SUPABASE_AUTH_URL=$VITE_SUPABASE_AUTH_URL
ENV VITE_SUPABASE_URL=$VITE_SUPABASE_URL
ENV VITE_PRIVY_APP_ID=$VITE_PRIVY_APP_ID
ENV VITE_REOWN_PROJECT_ID=$VITE_REOWN_PROJECT_ID
ENV VITE_ADMIN_TOKEN=$VITE_ADMIN_TOKEN

RUN npm run build

# Production stage
FROM nginx:alpine
COPY --from=builder /app/dist /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
