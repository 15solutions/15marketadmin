# ─── CORS ────────────────────────────────────────────────
# Comma-separated list of allowed origins.
# Production (Render): https://15market.online
# Development: add http://localhost:3000,http://localhost:5173
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,https://15market.online,https://api.15market.online
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Redis — RETIRED. The backend no longer connects to Redis/Upstash: all
# caching is in server memory (open trades additionally persist to
# data/open-trades.json). This variable is ignored if set; it remains
# documented here so old dashboards can be cleaned up deliberately.
# REDIS_URL=
