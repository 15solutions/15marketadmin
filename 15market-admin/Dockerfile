# Build stage
FROM node:20-alpine AS builder
WORKDIR /app
COPY package*.json ./
RUN npm install --legacy-peer-deps
ENV NODE_OPTIONS="--max-old-space-size=2048"
COPY . .

# Build-time environment variables
ARG VITE_SOLANA_RPC
ARG VITE_ARC_RPC
ARG VITE_ARC_CONTRACT_ADDRESS
ARG VITE_ADMIN_TOKEN
ARG VITE_KEEPER_URL
ARG VITE_KEEPER_URL_SOLANA
ARG VITE_KEEPER_URL_ARC
ARG VITE_KEEPER_URL_ROUNDS
ARG VITE_REOWN_PROJECT_ID
ARG VITE_SUPABASE_ANON_KEY
ARG VITE_SUPABASE_AUTH_URL
ARG VITE_SUPABASE_URL

ENV VITE_SOLANA_RPC=$VITE_SOLANA_RPC
ENV VITE_ARC_RPC=$VITE_ARC_RPC
ENV VITE_ARC_CONTRACT_ADDRESS=$VITE_ARC_CONTRACT_ADDRESS
ENV VITE_ADMIN_TOKEN=$VITE_ADMIN_TOKEN
ENV VITE_KEEPER_URL=$VITE_KEEPER_URL
ENV VITE_KEEPER_URL_SOLANA=$VITE_KEEPER_URL_SOLANA
ENV VITE_KEEPER_URL_ARC=$VITE_KEEPER_URL_ARC
ENV VITE_KEEPER_URL_ROUNDS=$VITE_KEEPER_URL_ROUNDS
ENV VITE_REOWN_PROJECT_ID=$VITE_REOWN_PROJECT_ID
ENV VITE_SUPABASE_ANON_KEY=$VITE_SUPABASE_ANON_KEY
ENV VITE_SUPABASE_AUTH_URL=$VITE_SUPABASE_AUTH_URL
ENV VITE_SUPABASE_URL=$VITE_SUPABASE_URL

ENV CI=true
RUN npm run build -- --logLevel info

# Production stage
FROM nginx:alpine
COPY --from=builder /app/dist /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
